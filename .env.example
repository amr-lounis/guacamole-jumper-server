# Copy to .env and fill with real secrets (never commit .env)
# cp .env.example .env

# Database - use a long random password, e.g.: openssl rand -base64 32
POSTGRES_PASSWORD=CHANGE_ME_GENERATE_A_STRONG_PASSWORD

# SAML Configuration (uncomment when IdP metadata is placed at ./saml/metadata.xml
# and the SAML_* vars are enabled in docker-compose.yml)
#SAML_ENTITY_ID=guacamole-saml
#SAML_CALLBACK_URL=https://your-domain/
